{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(~/.aws/credentials)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -r \"/opt/nulogic/secret-guard.sh\" ] || { echo 'NULogic secret-guard is missing. Contact IT.' >&2; exit 2; }; bash \"/opt/nulogic/secret-guard.sh\" || exit 2",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit|Grep|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "[ -r \"/opt/nulogic/secret-guard.sh\" ] || { echo 'NULogic secret-guard is missing. Contact IT.' >&2; exit 2; }; bash \"/opt/nulogic/secret-guard.sh\" || exit 2",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "allowManagedHooksOnly": true
}
